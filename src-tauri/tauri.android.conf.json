{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "MTG Collection Manager",
    "version": "0.1.1",
    "identifier": "com.mtgcollectionmanager.app",
    "build": {
        "beforeDevCommand": "npm run dev",
        "devUrl": "http://localhost:1420",
        "beforeBuildCommand": "npm run build",
        "frontendDist": "../dist"
    },
    "app": {
        "windows": [
            {
                "title": "MTG Collection Manager",
                "width": 400,
                "height": 800,
                "fullscreen": false,
                "resizable": true
            }
        ],
        "security": {
            "csp": null
        }
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.png"
        ],
        "android": {
            "minSdkVersion": 24
        }
    },
    "plugins": {
        "opener": {}
    }
}